server:
  #port: 0 # Use random port for local development to avoid conflicts. Eureka will register the actual port at runtime.
  port: XXXX #--> Docker
  error:
    include-binding-errors: always
    include-message: always
spring:
  application:
    name: fountation-authorization-service
  main:
    web-application-type: reactive
  r2dbc:
    password: XXXXXXXXXXXXXXXXXXXXXXXX
    url: r2dbc:postgresql://XXXXXXXXXXXXXXXXXXXXXXXX:XXXXXXXXXXXXXXXXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX
    username: XXXXXXXXXXXXXXXXXXXXXXXX
  security:
    oauth2:
      client:
        provider:
          auth0:
            authorization-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX/authorize?audience=https://XXXXXXXXXXXXXXXXXXXXXXXX/
            issuer-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX/
            jwk-set-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX/
            token-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX
            user-info-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX
        registration:
          auth0:
            authorization-grant-type: authorization_code
            client-id: XXXXXXXXXXXXXXXXXXXXXXXX
            client-name: Auth0
            client-secret: XXXXXXXXXXXXXXXXXXXXXXXX
            provider: auth0
            redirect-uri: http://XXXXXXXXXXXXXXXXXXXXXXXX
            scope: openid,profile,email
          internal-service:
            authorization-grant-type: client_credentials
            client-id: XXXXXXXXXXXXXXXXXXXXXXXX
            client-name: XXXXXXXXXXXXXXXXXXXXXXXX
            client-secret: XXXXXXXXXXXXXXXXXXXXXXXX
            provider: auth0
            scope: internal:service
      resourceserver:
        jwt:
          audiences:
            - https://XXXXXXXXXXXXXXXXXXXXXXXX
            - https://XXXXXXXXXXXXXXXXXXXXXXXX/
          issuer-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX/
          jwk-set-uri: https://XXXXXXXXXXXXXXXXXXXXXXXX
  data:
    redis:
      host: XX.XX.XX.XX
      port: XXXX
      database: XX
      password: XXXX
eureka:
  client:
    serviceUrl:
      defaultZone: ${EUREKA_URI:http://XXXXXXXXXXXXXXXXXXXXXXXX}
  instance:
        prefer-ip-address: false                       # Local setup forces Eureka to use IP instead of hostname
        ip-address: XXXXXXXXXXXXX                      # Local setup forces Eureka to use IP instead of hostname
        hostname: fountation-authorization-service     # use the Swarm DNS alias
        non-secure-port: XXXX                          # internal container port
fountation:
  service:
    users:
      url: lb://fountation-user-service
    ui:
      url: http://fountationui
    security:
      jwt:
        audience: https://myproject.local/api
    redis:
      store:
        duration:
          minutes: 10
logging:
    level:
        org:
            springframework:
                security: trace